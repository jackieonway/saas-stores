# Optional reviewed map; sample scopes must match the actual platform and identity registry.
# PLATFORM_RESOURCE_SCOPE_BINDINGS={"store:read":"stores:read","store:create":"stores:create","store:update":"stores:update","store-staff:read":"stores:staff:read","store-daily-report:read":"stores:reports:read","store-daily-report:create":"stores:reports:create","store-daily-report:update":"stores:reports:update"}
EDGE_NETWORK_NAME=platform-edge
API_PORT=3031
FRONTEND_PORT=3014

# Database URI points to stores-postgres:5432/stores; percent-encode credentials as needed.
# Configure actual public HTTPS routes in the ingress; do not place client secrets in frontend builds.
