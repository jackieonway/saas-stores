{
  "name": "stores-frontend",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "独立 React / TypeScript / Vite 门店 qiankun 微应用",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.22.1",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:release": "node deploy/verify-release.mjs",
    "release:local": "node deploy/local/publish-release.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "parse5": "8.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
